{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "rootDir": "./site/scripts",
      "outDir": "./site/scripts",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true
    },
    "include": ["site/scripts/**/*.ts"]
  }