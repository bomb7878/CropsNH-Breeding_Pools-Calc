{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./site/scripts",
    "outDir": "./site/scripts"
  },
  "include": ["site/scripts/**/*.ts"],
  "exclude": ["node_modules"]
}