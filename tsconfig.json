{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "allowJs": true,
      "checkJs": false,
      "outDir": "./dist"
    },
    "include": ["site/scripts/**/*.ts", "site/scripts/**/*.js"]
  }